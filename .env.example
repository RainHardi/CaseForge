# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# Free-tier LLM API key (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model id. Pick one from the model list in Google AI Studio and pin it for the
# final tests (Question Log Q-015). "gemini-flash-latest" always points at the newest Flash.
GEMINI_MODEL=gemini-flash-latest

# When the model above answers "busy" (503 high demand / rate limit) after its retries, the same request
# is sent to these models, in order. Leave as is, or list models your key can use.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# auto    = use Gemini when GEMINI_API_KEY is set, otherwise offline rules
# gemini  = always Gemini (fails if no key)
# offline = never call an LLM (free, deterministic — used by the tests)
CASEFORGE_LLM_MODE=auto

# Where project records are stored (default: data/projects inside the repo, git-ignored)
# CASEFORGE_DATA_DIR=

# ---- website (web/main.py) ----
# Long random string that signs login cookies. Generate one: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Database. Leave empty on your laptop (uses data/caseforge.db). When hosting, paste your Neon connection string.
DATABASE_URL=
# AI actions (drafts + formats) each user may run per day — protects the free Gemini quota
DAILY_AI_LIMIT=30

# ---- Connect Notion (optional) ----
# Create a PUBLIC integration at https://www.notion.so/profile/integrations (OAuth, "Any workspace",
# capability: Read content) and add the redirect URI below to it. Leave empty to show only the
# "integration secret" import. No Notion review is needed unless you list it on the Marketplace.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional: defaults to <this site>/api/notion/callback. Must match the URI in Notion exactly.
# Local: http://localhost:8000/api/notion/callback   Render: https://caseforge-rcdu.onrender.com/api/notion/callback
NOTION_REDIRECT_URI=
