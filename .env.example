# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# Free-tier LLM API key (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model id. Pick one from the model list in Google AI Studio and pin it for the
# final tests (Question Log Q-015). "gemini-flash-latest" always points at the newest Flash.
GEMINI_MODEL=gemini-flash-latest

# auto    = use Gemini when GEMINI_API_KEY is set, otherwise offline rules
# gemini  = always Gemini (fails if no key)
# offline = never call an LLM (free, deterministic — used by the tests)
CASEFORGE_LLM_MODE=auto

# Where project records are stored (default: data/projects inside the repo, git-ignored)
# CASEFORGE_DATA_DIR=
